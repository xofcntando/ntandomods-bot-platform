# ── Ntandomods Bot Platform — environment ────────────────────────
# Copy to .env and adjust. Every value has a safe default.

# HTTP port for the control plane
PORT=3000

# Public base URL of the control plane (used for live links)
BASE_URL=http://localhost:3000

# Wildcard domain for per-bot subdomains (empty → path-based /live/<slug> only)
ROOT_DOMAIN=

# First admin account seeded on boot
ADMIN_EMAIL=admin@ntandomods.local
ADMIN_PASSWORD=admin123

# Secrets — CHANGE THESE IN PRODUCTION
JWT_SECRET=change-me-please-this-is-a-dev-secret
INTERNAL_TOKEN=

# Storage
DATA_DIR=data

# Capacity limits
MAX_BOTS=50

# Auto-restart backoff (exponential, ms)
RESTART_BACKOFF_BASE_MS=1000
RESTART_BACKOFF_MAX_MS=60000

# Hard memory watchdog per bot (0 = disabled platform-wide fallback)
MEMORY_LIMIT_MB=0

# API rate limiting (per IP)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
